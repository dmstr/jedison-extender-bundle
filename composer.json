{
    "name": "dmstr/jedison-extender-bundle",
    "description": "Serves Jedison form editors from the API, so every front end talking to it renders the same widgets from one source",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "api-platform",
        "jedison",
        "json-schema",
        "form",
        "editor"
    ],
    "authors": [
        {
            "name": "diemeisterei GmbH",
            "homepage": "https://diemeisterei.de"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "^7.0",
        "symfony/http-kernel": "^7.0",
        "symfony/routing": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Dmstr\\JedisonExtender\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
